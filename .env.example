# No environment file is required or loaded by flinch.
# Pass checkpoint paths, thresholds and metadata explicitly through CLI flags.
#
# Optional Hugging Face / Transformers offline switches for local-only work:
# export HF_HUB_OFFLINE=1
# export TRANSFORMERS_OFFLINE=1
#
# These switches are consumed by dependencies, not by a dotenv loader. Leave
# them unset for a fresh scripts/scan_hub.py download; cached re-audits do not
# request network access unless --fetch-legacy-stats is explicitly supplied.
